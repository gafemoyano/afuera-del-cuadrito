---
import { getSinglePage } from "@/lib/contentParser.astro";
import {
  DEFAULT_LANGUAGE,
  getPostUrl,
  getTranslation,
  type Language,
} from "@/lib/utils/languageHelpers";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentLang: Language =
  pathname === "/en" || pathname.startsWith("/en/") ? "en" : DEFAULT_LANGUAGE;
const targetLang: Language = currentLang === "es" ? "en" : "es";

const homeFor = (lang: Language) =>
  lang === DEFAULT_LANGUAGE ? "/" : `/${lang}`;

let targetUrl = homeFor(targetLang);
let isLinked = true;

const routePairs: Record<string, string> = {
  "/": "/en",
  "/en": "/",
  "/about": "/en/about",
  "/en/about": "/about",
  "/contact": "/en/contact",
  "/en/contact": "/contact",
  "/tags": "/en/tags",
  "/en/tags": "/tags",
};

if (routePairs[pathname]) {
  targetUrl = routePairs[pathname];
} else if (pathname.startsWith("/tags/")) {
  targetUrl = `/en${pathname}`;
} else if (pathname.startsWith("/en/tags/")) {
  targetUrl = pathname.replace(/^\/en/, "");
} else if (pathname.startsWith("/page/")) {
  targetUrl = `/en${pathname}`;
} else if (pathname.startsWith("/en/page/")) {
  targetUrl = pathname.replace(/^\/en/, "");
} else {
  const postMatch = pathname.match(/^\/(es|en)\/(.+)$/);

  if (postMatch) {
    const [, lang, slug] = postMatch;
    const posts = await getSinglePage("posts");
    const currentPost = posts.find(
      (post) =>
        post.id === slug && (post.data.lang || DEFAULT_LANGUAGE) === lang,
    );
    const translation = currentPost ? getTranslation(currentPost, posts) : null;

    if (translation) {
      targetUrl = getPostUrl(translation);
    } else {
      isLinked = false;
    }
  }
}

const switchClasses =
  "relative inline-flex h-9 w-[4.5rem] items-center rounded-full border border-[#f6c37a] bg-[#fff3e0] p-1 text-[0.68rem] font-bold uppercase tracking-wide text-[#9a4a00] transition duration-200 focus:outline-none focus:ring-2 focus:ring-[#d97706] focus:ring-offset-2";
const knobClasses = [
  "absolute top-1 h-7 w-8 rounded-full bg-[#d97706] shadow-sm transition-transform duration-200",
  currentLang === "en" ? "translate-x-8" : "translate-x-0",
];
const spanishLabelClasses = [
  "relative z-10 flex h-7 w-8 items-center justify-center transition-colors duration-200",
  currentLang === "es" ? "text-white" : "text-[#9a4a00]",
];
const englishLabelClasses = [
  "relative z-10 flex h-7 w-8 items-center justify-center transition-colors duration-200",
  currentLang === "en" ? "text-white" : "text-[#9a4a00]",
];
---

{
  isLinked ? (
    <a
      href={targetUrl}
      class={`${switchClasses} hover:border-[#d97706] hover:bg-[#ffe4bd]`}
      role="switch"
      aria-checked={currentLang === "en"}
      aria-label={`Cambiar idioma a ${targetLang === "es" ? "español" : "inglés"}`}
      title={`Cambiar idioma a ${targetLang === "es" ? "español" : "inglés"}`}
    >
      <span class:list={knobClasses} aria-hidden="true" />
      <span class:list={spanishLabelClasses}>ES</span>
      <span class:list={englishLabelClasses}>EN</span>
    </a>
  ) : (
    <span
      class={`${switchClasses} cursor-default opacity-70`}
      role="switch"
      aria-checked={currentLang === "en"}
      aria-label={`No hay traducción disponible en ${targetLang === "es" ? "español" : "inglés"}`}
      title={`No hay traducción disponible en ${targetLang === "es" ? "español" : "inglés"}`}
    >
      <span class:list={knobClasses} aria-hidden="true" />
      <span class:list={spanishLabelClasses}>ES</span>
      <span class:list={englishLabelClasses}>EN</span>
    </span>
  )
}
