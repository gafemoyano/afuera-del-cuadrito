---
import config from "@/config/config.json";
import dateFormat from "@/lib/utils/dateFormat";
import { getPostUrl } from "@/lib/utils/languageHelpers";
import { humanize, plainify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";

type Props = {
  posts: CollectionEntry<"posts">[];
  className?: string;
  fluid?: boolean;
};

const { summary_length } = config.settings;
const { className, posts, fluid } = Astro.props;
---

<div
  class={`row gy-5 gx-4 ${className} ${posts.length == 1 ? "justify-center" : ""} `}
>
  {
    posts.map((post, i: number) => {
      const isFeatured = i === 0 && fluid != false;
      const postUrl = getPostUrl(post);

      return (
        <div class={isFeatured ? "col-12" : "col-12 sm:col-6"}>
          {post.data.image && (
            <a href={postUrl} class="image-frame group hover:text-primary">
              <Image
                class="image-frame__img transition duration-300 group-hover:scale-[1.03]"
                src={post.data.image}
                alt={post.data.title}
                width={isFeatured ? 925 : 445}
                height={isFeatured ? 475 : 230}
              />
            </a>
          )}
          <ul class="mt-6 mb-4 flex flex-wrap items-center text-text">
            {(() => {
              const formattedDate = dateFormat(post.data.date);
              return formattedDate ? (
                <li class="mr-5 flex items-center flex-wrap">
                  <BiCalendarEdit className="mr-1 h-5 w-5 text-gray-600" />
                  {formattedDate}
                </li>
              ) : null;
            })()}
            {post.data.tags?.length ? (
              <li class="mr-5 flex items-center flex-wrap">
                <BiCategoryAlt className="mr-1 h-[18px] w-[18px] text-gray-600" />

                <ul>
                  {post.data.tags.map((tag) => (
                    <li class="inline-block">
                      <a
                        href={`/tags/${tag}`}
                        class="px-4 py-2 text-primary font-semibold  transition ease-in-out hover:text-secondary flex items-center group relative hover:border-b-2  duration-500 font-primary"
                      >
                        {humanize(tag || "")}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : null}
          </ul>
          <h3 class="mb-4">
            <a
              href={postUrl}
              class="block hover:text-primary transition duration-300"
            >
              {post.data.title}
            </a>
          </h3>
          <p class="text-text">
            {plainify(
              (post.body ?? "").slice(
                0,
                Number(isFeatured ? summary_length * 2 : summary_length),
              ),
            )}
            ...
          </p>
        </div>
      );
    })
  }
</div>
