---
import Social from "@/components/Social.astro";
import config from "@/config/config.json";
---

<footer class="section py-8 border-t-2 border-light">
  <div class="container">
    <div class="flex justify-between items-center">
      {/* social icons aligned to right */}
      <div class="flex space-x-4">
        <Social 
          source={config.social} 
          className="text-primary hover:text-dark transition-colors" 
        />
      </div>
      
      {/* copyright */}
      <p class="text-text-dark font-medium">
        © 2026 Juliana Ramírez Muñoz
      </p>
    </div>
  </div>
</footer>
