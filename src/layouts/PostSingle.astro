---
import Share from "@/components/Share.astro";
import SimilarPosts from "@/components/SimilarPosts.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import Comments from "@/shortcodes/Comments";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import similerItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { getPostUrl, getPostsByLanguage, DEFAULT_LANGUAGE } from "@/lib/utils/languageHelpers";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { BiCalendarEdit } from "react-icons/bi";

import { FaHashtag } from "react-icons/fa";

const posts = await getSinglePage("posts");
const { post } = Astro.props;
const postLang = post.data.lang || DEFAULT_LANGUAGE;
// Only show similar posts from the same language
const sameLangPosts = getPostsByLanguage(posts, postLang);
const similarPosts = similerItems(post, sameLangPosts, post.slug);
const { Content } = await render(post);
const { title, description, image, date, tags } = post.data;
const formattedDate = dateFormat(date);
---

<section class="section">
  <div class="container">
    <article class="row justify-center">
      <div class="md:col-10 text-center">
        <h1 set:html={markdownify(title)} class="h2" />
        <ul class="mt-4 flex flex-wrap items-center justify-center text-text">
          {
            formattedDate && (
              <li class="mx-3 flex items-center flex-wrap">
                <BiCalendarEdit className="mr-1 h-5 w-5 text-gray-600" />
                {formattedDate}
              </li>
            )
          }
        </ul>
        <LanguageSwitcher currentPost={post} />
      </div>

      <div class="col-12 mt-8 mb-2">
        {
          image && (
            <div class="image-frame image-frame--wide">
              <Image
                src={image}
                height={500}
                width={1000}
                alt={title}
                class="image-frame__img"
              />
            </div>
          )
        }
      </div>

      <div class="md:col-10">
        <div class="content mb-16 text-left">
          <Content />
        </div>
        <div class="flex flex-wrap items-center justify-between">
          <ul class="mr-4 mb-4 space-x-3">
            {
              tags.map((tag: string, index: number) => (
                <li class="inline-block">
                  <a
                    href={`/tags/${tag}`}
                    class:list={["py-2 pr-4 text-primary font-semibold text-xl transition ease-in-out hover:text-secondary flex items-center group relative hover:border-b-2 duration-500 font-primary", index === 0 ? "pl-0" : "pl-4"]}
                  >
                    <FaHashtag className="mr-1 text-primary  transition" />
                    {humanize(tag || "")}
                  </a>
                </li>
              ))
            }
          </ul>
          <Share
            className="social-share mb-4"
            title={title}
            description={description}
            slug={`${postLang}/${post.id}`}
          />
        </div>
      </div>

      <div class="md:col-10">
        <Comments client:visible postSlug={post.id} />
      </div>
    </article>
  </div>
</section>

<!-- similar posts -->
{
  similarPosts.length > 0 && (
    <section class="section pt-0">
      <div class="container">
        <h2 class="mb-8 text-center h3">Entradas relacionadas</h2>
        <SimilarPosts posts={similarPosts.slice(0, 3)} />
      </div>
    </section>
  )
}
