---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getPostsByLanguage } from "@/lib/utils/languageHelpers";
import { humanize } from "@/lib/utils/textConverter";

import { FaHashtag } from "react-icons/fa";

const posts = await getSinglePage("posts");
const tags = [
  ...new Set(
    getPostsByLanguage(posts, "en")
      .map((post) => post.data.tags)
      .flat(),
  ),
].sort();
---

<Base title={"Tags"}>
  <section class="section">
    <div class="container text-center">
      <h1 class="h2 page-heading">Tags</h1>
      <ul class="space-x-4">
        {
          tags.map((tag) => (
            <li class="inline-block">
              <a
                href={`/en/tags/${tag}`}
                class="px-4 py-2 text-primary font-semibold text-xl transition ease-in-out hover:text-secondary flex items-center group relative hover:border-b-2 duration-500 font-primary"
              >
                <FaHashtag className="mr-1 text-primary transition" />
                {humanize(tag || "")}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
