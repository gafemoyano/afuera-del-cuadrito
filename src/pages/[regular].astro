---
import Base from "@/layouts/Base.astro";
import Default from "@/layouts/Default.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getPostUrl, DEFAULT_LANGUAGE } from "@/lib/utils/languageHelpers";
import type { CollectionEntry } from "astro:content";

// Check if this is a post slug that needs redirecting
const getPosts = (await getSinglePage("posts")) as CollectionEntry<"posts">[];
const postSlugs = new Map(getPosts.map((post) => [post.id, post]));

export async function getStaticPaths() {
  const pages = await getSinglePage("pages");
  const posts = await getSinglePage("posts");

  // Pages routes
  const pagePaths = pages.map((page) => ({
    params: {
      regular: page.id.replace(/\.(md|mdx)$/, ""),
    },
    props: { page, isPost: false },
  }));

  // Redirect routes for old post URLs
  const postRedirects = posts.map((post) => ({
    params: {
      regular: post.id,
    },
    props: { page: post, isPost: true },
  }));

  return [...pagePaths, ...postRedirects];
}

const { page, isPost } = Astro.props;

// Redirect old post URLs to new language-prefixed URLs
if (isPost) {
  const post = page as CollectionEntry<"posts">;
  return Astro.redirect(getPostUrl(post), 301);
}

const { title, meta_title, description, image } = page.data;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <Default data={page} />
</Base>
